# Data is downloaded at build time (`make data`), never versioned
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Generated analysis outputs stay local, except the aggregate tables behind README.md and docs/findings.md.
# Each tracked file is named: per-draw tables, per-customer predictions and raw data are never committed.
reports/figures/*
reports/validation/*
reports/results/**
!reports/results/**/
!reports/**/.gitkeep
!reports/validation/validation_raw.json
!reports/results/*/provenance.json
reports/results/extension/provenance.json
!reports/results/experiment/effects.csv
!reports/results/experiment/relative_lift.csv
!reports/results/experiment/balance.csv
!reports/results/experiment/diagnostics.csv
!reports/results/benchmark/bias_decomposition.csv
!reports/results/comparison/display_draw.csv
!reports/results/comparison/performance.csv
!reports/results/heterogeneity/verdicts.csv
!reports/results/heterogeneity/policy_differences.csv
!reports/results/robustness/experiment_robustness.csv
!reports/results/robustness/bootstrap_stability.csv
!reports/results/robustness/refutation_summary.csv
!reports/results/robustness/sensitivity_summary.csv
!reports/results/findings/estimator_table.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# Notebooks and editors
.ipynb_checkpoints/
.DS_Store
.vscode/
.idea/

# Local environment and secrets
.env
.env.*
*.pem
